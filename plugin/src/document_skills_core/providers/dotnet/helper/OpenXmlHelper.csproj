<!-- OpenXmlHelper — C# helper for the dotnet-openxml enhancement provider.

  Module provenance: original Elftia-authored clean-room implementation.
  This project is invoked ONLY through the contained ProcessRunner with a
  validated helper project and separated subcommand. The exact OpenXML dependency
  graph is pinned by packages.lock.json and restored only in locked mode from its
  package source into project-private temporary cache and configuration roots. User
  NuGet cache/configuration is not read or required, and packages are NEVER bundled.
  The helper does NOT execute macros, VBA, DDE, or external-data refresh.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenXmlHelper</AssemblyName>
    <Version>0.5.6</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="[3.0.0]" />
  </ItemGroup>

</Project>

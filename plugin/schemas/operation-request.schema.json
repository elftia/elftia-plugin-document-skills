{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elftia.dev/document-skills/operation-request.schema.json",
  "title": "Document Skills operation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "input": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fidelity": {"type": "string", "enum": ["core", "enhanced", "full"], "default": "core"},
        "allow_degraded": {"type": "boolean", "default": false},
        "in_place": {"type": "boolean", "default": false}
      }
    },
    "arguments": {"type": "object", "default": {}}
  },
  "examples": [
    {
      "schema_version": "1.0",
      "operation": "docx.inspect.structure",
      "input": "sample.docx",
      "options": {"fidelity": "core", "allow_degraded": false, "in_place": false},
      "arguments": {}
    }
  ]
}


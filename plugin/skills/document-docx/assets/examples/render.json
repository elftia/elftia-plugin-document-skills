{
  "schema_version": "1.0",
  "operation": "docx.render",
  "input": "<input.docx>",
  "output": "<rendered.pdf>",
  "options": {"fidelity": "enhanced"},
  "arguments": {
    "format": "pdf",
    "page_range": {"start": 1, "end": 3},
    "include_page_pngs": true,
    "dpi": 96,
    "layout_profile": "professional-v1",
    "max_pages": 3,
    "max_page_bytes": 500000,
    "max_png_total_bytes": 1000000,
    "max_total_bytes": 67108864
  }
}

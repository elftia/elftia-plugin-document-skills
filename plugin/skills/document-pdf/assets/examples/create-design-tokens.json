{
  "schema_version": "1.0",
  "operation": "pdf.create",
  "output": "replace-with-output.pdf",
  "arguments": {
    "document": {
      "metadata": {
        "title": "Tokenized report",
        "author": "Elftia",
        "subject": "Typed PDF design tokens"
      },
      "design_tokens": {
        "page_size": "A4",
        "margin": {
          "top": 54,
          "right": 54,
          "bottom": 54,
          "left": 54
        },
        "palette": {
          "ink": [0.08, 0.1, 0.14],
          "accent": [0.12, 0.42, 0.78]
        },
        "typography": {

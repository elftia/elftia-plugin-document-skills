              "shape": null
            },
            {
              "type": "paragraph",
              "text": "Replace this paragraph with the validated report body.",
              "style": null,
              "table": null,
              "image": null,
              "shape": null
            }
          ],
          "metadata": null
        }
      ]
    }
  }
}
